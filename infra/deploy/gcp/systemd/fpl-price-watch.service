[Unit]
Description=FPL price-change watch (twice daily, silent unless owned/target moved)

[Service]
Type=oneshot
User=fpl
Group=fpl
WorkingDirectory=/opt/fpl-autopilot
Environment=HOME=/home/fpl
Environment=FPL_AUTOPILOT_HOME=/opt/fpl-autopilot
Environment=TZ=Asia/Kuala_Lumpur
TimeoutStartSec=300
ExecStart=/bin/bash -c '/opt/fpl-autopilot/.venv/bin/python /opt/fpl-autopilot/jobs/price_watch.py | /opt/fpl-autopilot/.venv/bin/python /opt/fpl-autopilot/jobs/deliver_stdout.py --tag "price watch"'
StandardOutput=append:/var/log/fpl/jobs.log
StandardError=append:/var/log/fpl/jobs.log
