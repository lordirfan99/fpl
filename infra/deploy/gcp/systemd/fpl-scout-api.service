[Unit]
Description=Fantasy Scout read-only API on the existing VM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fpl
Group=fpl
WorkingDirectory=/opt/fpl-live-refresh/current/api
EnvironmentFile=/etc/fpl-scout-api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fpl-live-refresh/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8790 --workers 1 --limit-concurrency 2 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryHigh=450M
MemoryMax=650M
TasksMax=64

[Install]
WantedBy=multi-user.target
