[Unit]
Description=Refresh FPL live leagues on the existing VM every 30 minutes

[Timer]
# Recover fresh state promptly after activation/reboot instead of waiting for
# the next half-hour slot. The same oneshot unit still prevents overlap.
OnActiveSec=1min
# Preserve the former scheduler's UTC window; explicit UTC ignores VM timezone.
OnCalendar=*-*-* 07..23:00,30:00 UTC
Persistent=true
RandomizedDelaySec=60
Unit=fpl-live-refresh.service

[Install]
WantedBy=timers.target
