[Unit]
Description=FPL auto-runner (pre-deadline + post-GW review, every 2h)

[Service]
Type=oneshot
User=fpl
Group=fpl
WorkingDirectory=/opt/fpl-autopilot
Environment=HOME=/home/fpl
Environment=FPL_AUTOPILOT_HOME=/opt/fpl-autopilot
Environment=TZ=Asia/Kuala_Lumpur
TimeoutStartSec=900
ExecStart=/bin/bash -c '/opt/fpl-autopilot/.venv/bin/python /opt/fpl-autopilot/jobs/fpl_auto.py | /opt/fpl-autopilot/.venv/bin/python /opt/fpl-autopilot/jobs/deliver_stdout.py --tag "auto-runner"'
StandardOutput=append:/var/log/fpl/jobs.log
StandardError=append:/var/log/fpl/jobs.log