FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/api \
    FPL_DATA_DIR=/app/data

WORKDIR /app
COPY api/requirements.txt ./api/requirements.txt
RUN pip install --no-cache-dir -r api/requirements.txt

COPY api/app ./api/app
COPY infra/scripts ./scripts
COPY data ./data

# The gameweek finalizer writes freshly fetched snapshots, analysis and journal
# files under data/ and reports/ before publishing them to GCS.
RUN mkdir -p data/journal/2026-27/exports data/journal-raw reports/model-validation \
    && chown -R 65532:65532 /app

USER 65532:65532
ENTRYPOINT ["python", "scripts/run_scheduled_task.py"]
